---
// 404 page: shown when no route matches.
import Layout from '../layouts/Layout.astro';

const title = "Page not found - Sujan Deswal";
const description = "The page you're looking for doesn't exist.";
---

<Layout title={title} description={description}>
  <h1>Page not found</h1>
  <p>The page you're looking for doesn't exist. <a href="/">Go back home</a>.</p>
</Layout>
