---
// Blog index: a plain list of post titles (linked) and dates, newest first.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const title = "Blog - Sujan Deswal";
const description = "Posts on B2B SaaS marketing, growth, and the occasional technical how-to.";
---

<Layout title={title} description={description}>
  <h1>Blog</h1>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </li>
    ))}
  </ul>

  <style>
    .post-list { list-style: none; margin: 0; padding: 0; }
    .post-list li { margin: 0.75rem 0; }
    .post-list time { display: block; font-size: 0.85rem; color: #555; }
  </style>
</Layout>
