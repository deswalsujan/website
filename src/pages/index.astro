---
// Homepage: intro bio + list of guest posts.
import Layout from '../layouts/Layout.astro';

const title = "Sujan Deswal - B2B SaaS Marketer";
const description = "B2B SaaS marketer helping companies acquire and retain customers. Previously EquityList, AdPushup, Squad, and Hiver.";

// Add a new entry here each week a build ships. Newest first.
const linkedin = "https://linkedin.com/in/sujan-deswal-24b20518";
// Add `writeup: "https://..."` once a week's Friday post goes live.
const builds = [
  {
    week: 2,
    title: "GEO Visibility Tracker (contd.)",
    repo: "https://github.com/deswalsujan/geo-visibility-tracker",
    writeup: "/blog/sprint-week-2",
    description: "Now asks three models 27 buyer questions every morning and posts a weekly Slack update on which brands gained or lost visibility in AI answers.",
  },
  {
    week: 1,
    title: "GEO Visibility Tracker",
    repo: "https://github.com/deswalsujan/geo-visibility-tracker",
    writeup: "/blog/sprint-week-1",
    description: "A daily GitHub Action that asked Gemini Flash one buyer question in the cap table software category and logged the answer.",
  },
];
---

<Layout title={title} description={description}>
  <h1 class="hero-title">Hi, I'm Sujan Deswal</h1>
  <p>I'm a marketer helping B2B SaaS companies get customers who'll be happy to pay them.</p>
  <p><strong>Currently:</strong> Exploring opportunities and working on AI side projects.</p>
  <p><strong>Previously:</strong></p>
  <ul class="roles">
    <li><a href="https://www.equitylist.co" target="_blank">EquityList</a> (2024-2026): Marketing Lead</li>
    <li><a href="https://hiverhq.com" target="_blank">Hiver</a> (2019-2023): Head of Demand Gen, later Associate Director of Product Marketing</li>
    <li><a href="https://www.classifyit.co/" target="_blank">Squad</a> (2017-2018): Sr. Growth Marketer</li>
    <li><a href="https://www.adpushup.com" target="_blank">AdPushup</a> (2014-2017): Content Marketer</li>
  </ul>
  <p>If you'd like to reach me, drop a message on LinkedIn.</p>

  <style>
    .roles{margin-top:.75rem}
    section ul.roles{
      display:block;
      list-style:disc;
      padding-left:1.25rem;
    }
    section ul.roles li{
      font-size:1rem;
      line-height:1.5;
    }
  </style>

  <Fragment slot="after-header">
    <hr>

    <section>
      <h2>Building in public</h2>
      <p>Six weeks, one build a week, using Claude Code as the primary tool. Each build gets its own public repo from day one. Following along here and on <a href={linkedin} target="_blank">LinkedIn</a>.</p>
      <ul class="roles">
        {builds.map((build) => (
          <li>
            <strong>Week {build.week}:</strong> <a href={build.repo} target="_blank">{build.title}</a>. {build.description}{build.writeup && (<> Read <a href={build.writeup}>the write-up</a>.</>)}
          </li>
        ))}
      </ul>
    </section>

    <hr>

    <section>
      <h2>Guest posts (yes, they're old)</h2>
      <ul>
        <li><strong>The Next Web</strong>: <a href="https://web.archive.org/web/20221006214756/https://thenextweb.com/news/22-reasons-why-web-publishers-need-eye-tracking" target="_blank">22 Reasons Why Web Publishers Need Eye-tracking</a></li>
        <li><strong>ConversionXL</strong>: <a href="https://cxl.com/blog/banner-ads-suck-boost-ctr/" target="_blank">Banner Ads Suck (and How to Make Them Convert Better)</a></li>
        <li><strong>Semrush</strong>: <a href="https://web.archive.org/web/20181204125441/semrush.com/blog/4-psychological-insights-that-will-hook-readers-to-your-content/" target="_blank">4 Psychological Insights that Will Hook Readers to Your Content</a></li>
        <li><strong>Mention</strong>: <a href="https://web.archive.org/web/20200810155611/https://mention.com/en/blog/email-outreach-tips/" target="_blank">7 Email Outreach Tips to Get More Replies</a></li>
        <li><strong>Medium</strong>: <a href="https://medium.com/@SujanDeswal/startup-marketing-101-the-only-3-things-you-need-to-start-content-marketing-e3cec44f79c3" target="_blank">Startup Marketing 101 — The Only 3 Things You Need to Start Content Marketing</a></li>
        <li><strong>Classifyit</strong>: <a href="https://archive.ph/dX0Mm" target="_blank">The Future Of Content Moderation: Humans And A.I.</a></li>
      </ul>
    </section>
  </Fragment>
</Layout>
