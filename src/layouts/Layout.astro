---
// Shared page shell: head (meta tags, critical CSS, stylesheet) + top nav.
// Pages pass in their own title/description so this can be reused for blog posts too.
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isBlog = pathname.startsWith("/blog");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO Meta (unchanged) -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Sujan Deswal">
  <link rel="canonical" href={canonicalURL}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">

  <!-- Open Graph / Twitter (unchanged) -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://sujandeswal.com/assets/images/sujan_deswal_headshot_2025.webp">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@sujandeswal">
  <meta name="twitter:creator" content="@sujandeswal">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://sujandeswal.com/assets/images/sujan_deswal_headshot_2025.webp">

  <!-- Critical CSS (tiny, above-the-fold only) -->
  <style>
    *{box-sizing:border-box}
    body{
      font-family: var(--font-sans);
      color:var(--ink); background:var(--paper); font-size:1rem; line-height:1.5;
      margin:0 auto; max-width:var(--measure); padding:1.5rem 1rem;
      -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    }
    @media (min-width:1200px){ body{ margin-left:12%; margin-right:auto } }
    header{display:flex; flex-direction:column; align-items:center}
    header .container{max-width:var(--measure); min-width:0; width:100%; margin:0 auto; text-align:left}
    h1{margin:.25rem 0 .5rem; font-size:2rem; line-height:1.2; font-weight:650}
    p{margin:0 0 1.5em}
    a{color:inherit; text-decoration:underline}
    a:hover{text-decoration:underline}
    /* Masthead essentials (keep the row from jumping when style.css lands) */
    .masthead{display:flex; align-items:center; justify-content:space-between; width:100%; max-width:var(--measure); margin:0 auto 3rem; padding:1.5rem 0 1rem; border-bottom:1px solid var(--rule)}
    .wordmark{font-size:1rem; font-weight:500; color:var(--ink); text-decoration:none}
    ul.navbar{list-style:none; margin:0; padding:0; display:flex; gap:1.5rem}
    ul.navbar a{position:relative; font-weight:500; font-size:.875rem; letter-spacing:.01em; padding:.4rem 0; color:var(--ink-muted); text-decoration:none}
    ul.navbar a::after{content:""; position:absolute; bottom:0; left:0; width:0; height:2px; background:var(--ink); transition:width .3s ease}
    ul.navbar a:hover::after{width:100%}
    ul.navbar a.active{font-weight:700}
    ul.navbar .nav-icon{vertical-align:-2px; margin-right:.3em}
    @media (max-width:600px){ .masthead{flex-direction:column; align-items:flex-start; gap:.75rem} }

    /* Stabilize LCP if your hero image is above the fold */
    .hero-img{width:160px; height:160px; border-radius:50%; display:block}
    @media (max-width:600px){ h1{font-size:1.6rem} }

    /* Reduce CLS confirmation delay for text-based LCP (homepage title only — blog titles vary in length) */
    .hero-title{min-height:2.2em}
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body>
  <header>
    <div class="masthead">
      <a href="/" class="wordmark">Sujan Deswal</a>
      <nav>
        <ul class="navbar">
          <li><a href="/blog/" class:list={{ active: isBlog }} aria-current={isBlog ? "page" : undefined}>Blog</a></li>
          <li><a href="https://github.com/deswalsujan" target="_blank"><svg class="nav-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg> GitHub</a></li>
          <li><a href="https://linkedin.com/in/sujan-deswal-24b20518" target="_blank">LinkedIn</a></li>
          <li><a href="https://x.com/sujandeswal" target="_blank">X (Twitter)</a></li>
        </ul>
      </nav>
    </div>

    <div class="container">
      <slot />
    </div>
  </header>

  <slot name="after-header" />
</body>
</html>
